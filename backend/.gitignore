# Ambiente virtual
.venv/
venv/
env/

# Cache Python
__pycache__/
*.py[cod]
*.egg-info/

# Variáveis de ambiente reais (NUNCA versionar — use .env.example)
.env
.env.*
!.env.example

# Pesos de modelos baixados em runtime (YOLOv8-face / HSEmotion / torch hub)
weights/
*.pt
# Exceção: checkpoint de terceiros (community fine-tune de face sobre YOLOv8),
# não coberto pelo auto-download da lib ultralytics — versionado propositalmente
# para que o projeto rode após um clone limpo.
!yolov8n-face.pt

# Uploads temporários
*.tmp
